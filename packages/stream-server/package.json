{
  "name": "@simulacra-ai/stream-server",
  "version": "0.0.12",
  "description": "Server-side encoder for streaming Simulacra Conversation events over HTTP using the @simulacra-ai/core wire format",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./node": {
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      },
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@simulacra-ai/core": "0.0.12"
  },
  "devDependencies": {
    "@simulacra-ai/stream-client": "*",
    "@types/node": "^20.0.0",
    "vitest": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/simulacra-ai/simulacra.git",
    "directory": "packages/stream-server"
  },
  "homepage": "https://github.com/simulacra-ai/simulacra",
  "keywords": [
    "ai",
    "llm",
    "agent",
    "ndjson",
    "streaming",
    "http",
    "simulacra"
  ],
  "license": "MIT"
}
